# GnomeSpeak commands.toml — configure pre-set commands for the remote

[[command]]
id    = "lock"
label = "Lock Screen"
icon  = "🔒"
run   = ["loginctl", "lock-session"]

[[command]]
id      = "suspend"
label   = "Suspend"
icon    = "💤"
run     = ["systemctl", "suspend"]
confirm = true

[[command]]
id    = "youtube"
label = "Open YouTube"
icon  = "▶"
run   = ["xdg-open", "https://youtube.com"]

[[command]]
id    = "github"
label = "Open GitHub"
icon  = "🐙"
run   = ["xdg-open", "https://github.com"]

# Example: restart a service
# [[command]]
# id    = "restart-app"
# label = "Restart MyApp"
# icon  = "🔄"
# run   = ["systemctl", "restart", "myapp"]
# confirm = true

# A macro: one button, several things you could have tapped yourself. Steps
# name a target and an action -- the same pair the phone sends -- or a wait in
# seconds. They never name a program, so this stays as far from a shell as the
# rest of this file. The macro stops at the first step that fails.
[[command]]
id = "movie_mode"
label = "Movie mode"
icon = "🎬"
steps = [
  {target = "system:notifications", action = "dnd_on"},
  {target = "system:display", action = "night_light_on"},
  {wait = 0.5},
  {target = "system:audio", action = "volume", value = 0.4},
]
